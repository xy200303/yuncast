{
  "name": "agent-anchor",
  "version": "0.1.0",
  "description": "Agent Anchor - 智能体主播（AI 直播助播）",
  "main": "out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "selfcheck:podcast": "esbuild scripts/selfcheck-podcast-protocol.mts --bundle --platform=node --format=esm --outfile=node_modules/.tmp-selfcheck/podcast.mjs && node node_modules/.tmp-selfcheck/podcast.mjs",
    "icon": "node scripts/gen-icon.mjs",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.2.0",
    "@earendil-works/pi-ai": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "echarts": "^6.1.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.13.0",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "typebox": "^1.3.27",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "app.agentanchor.desktop",
    "productName": "Agent Anchor",
    "executableName": "Agent Anchor",
    "copyright": "Copyright © Agent Anchor",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "npmRebuild": true,
    "icon": "resources/icon.png",
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/@napi-rs/canvas/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
