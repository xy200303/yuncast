{
  "name": "yuncast",
  "version": "0.2.1",
  "description": "小云播客坊 YunCast - AI 直播工作台（智能主播 · 节目制作与播出）",
  "main": "out/main/index.js",
  "license": "MIT",
  "author": {
    "name": "xy200303",
    "email": "3483421977@qq.com"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "selfcheck:podcast": "esbuild scripts/selfcheck-podcast-protocol.mts --bundle --platform=node --format=esm --outfile=node_modules/.tmp-selfcheck/podcast.mjs && node node_modules/.tmp-selfcheck/podcast.mjs",
    "icon": "node scripts/gen-icon.mjs",
    "cli:build": "node scripts/build-cli.mjs",
    "dist": "node scripts/build-cli.mjs && electron-vite build && electron-builder --publish never",
    "dist:win": "node scripts/build-cli.mjs windows-amd64 && electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.2.0",
    "@earendil-works/pi-ai": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@streamdown/cjk": "^1.0.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "echarts": "^6.1.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.13.0",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-breaks": "^4.0.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "tw-animate-css": "^1.4.0",
    "typebox": "^1.3.27",
    "undici": "^7.30.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "app.yuncast.desktop",
    "productName": "小云播客坊",
    "executableName": "YunCast",
    "copyright": "Copyright © 小云播客坊 YunCast",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "cli/dist/${os}-${arch}",
        "to": "bin"
      }
    ],
    "npmRebuild": true,
    "icon": "resources/icon.png",
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/@napi-rs/canvas/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "YunCast.Setup.${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "YunCast-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "真人接管播报时需要使用麦克风"
      }
    },
    "linux": {
      "category": "AudioVideo",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "YunCast-${version}-${arch}.${ext}"
    }
  }
}
